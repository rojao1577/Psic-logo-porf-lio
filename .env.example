# Banco de dados (Neon ou Supabase) — connection string COM pooler.
# Ver CLAUDE.md > Stack decidida > Banco de dados.
DATABASE_URL="postgresql://usuario:senha@host-pooler/db?sslmode=require"

# Conexão direta (sem pooler), usada só pelas migrations do Prisma.
DIRECT_URL="postgresql://usuario:senha@host/db?sslmode=require"

# Admin único (painel em /admin)
ADMIN_EMAIL="admin@example.com"
# Gerar com: node -e "console.log(require('bcryptjs').hashSync('sua-senha', 10))"
ADMIN_PASSWORD_HASH=""

# Segredo da sessão do admin — string aleatória com 32+ caracteres.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
